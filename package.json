{
  "name": "novasocial-ai",
  "version": "0.1.0",
  "private": true,
  "description": "NovaSocial AI monorepo for an AI-first short-form social platform.",
  "engines": {
    "node": ">=26.4.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "backend",
    "mobile",
    "admin",
    "shared"
  ],
  "scripts": {
    "dev:api": "npm --workspace backend run start:dev",
    "dev:mobile": "npm --workspace mobile run start",
    "dev:admin": "npm --workspace admin run start",
    "mobile:eas:login": "npm --workspace mobile run eas:login",
    "mobile:build:android:preview": "npm --workspace mobile run build:android:preview",
    "mobile:build:android": "npm --workspace mobile run build:android",
    "mobile:build:ios": "npm --workspace mobile run build:ios",
    "mobile:submit:android": "npm --workspace mobile run submit:android",
    "mobile:submit:ios": "npm --workspace mobile run submit:ios",
    "build": "npm --workspace backend run build && npm --workspace admin run build",
    "test": "npm --workspace backend run test",
    "typecheck": "npm --workspace backend run typecheck && npm --workspace mobile run typecheck && npm --workspace admin run typecheck",
    "format": "npm --workspaces run format --if-present"
  },
  "keywords": [
    "social-media",
    "ai",
    "short-video",
    "nestjs",
    "expo",
    "react-native"
  ],
  "author": "",
  "license": "UNLICENSED"
}
