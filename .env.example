# App
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://localhost:5173
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Database
DATABASE_PROVIDER=mongodb
MONGODB_URI=mongodb://novasocial:novasocial@localhost:27017/novasocial?authSource=admin
MONGODB_DATABASE=novasocial
DATABASE_URL=postgresql://novasocial:novasocial@localhost:5432/novasocial
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-1.5-flash

# Storage
STORAGE_PROVIDER=r2
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=novasocial-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=https://cdn.novasocial.ai
MAX_VIDEO_BYTES=524288000

# Notifications
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
